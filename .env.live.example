# === PLATFORMA BOT — LIVE flota (uzivo mecevi) ===
# Kopiraj u .env.live i popuni. Pokretanje: node src/index.ts --env=.env.live

BASE_URL=https://www.singlbet.com
MODE=live

# 10 live naloga (primer). Koliko naloga — toliko live botova.
ACCOUNTS=test120:test120,test121:test121,test122:test122,test123:test123,test124:test124,test125:test125,test126:test126,test127:test127,test128:test128,test129:test129

TICKET_INTERVAL_SEC=60
TICKETS_BEFORE_PAUSE=100
PAUSE_MIN_MIN=1
PAUSE_MAX_MIN=30
STAKE_MIN=100
STAKE_MAX=500
LEGS_MIN=1
LEGS_MAX=7
SINGLE_PROB=0.30
FOOTBALL_PROB=0.50
MAX_ODDS=5
# MAX_HOURS_AHEAD se u live modu ignorise (mecevi su vec poceli).
MAX_HOURS_AHEAD=24
DRY_RUN=0
