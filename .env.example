# === PLATFORMA BOT — podesavanja ===
# Kopiraj u .env i popuni. .env se NIKAD ne komituje (vidi .gitignore).

# Adresa platforme (server, live). SinglBet radi preko HTTP.
BASE_URL=http://www.singlbet.com

# WebSocket ponude. Prazno = izvedi iz BASE_URL (host + /ws/prematch).
# WS_URL=ws://www.singlbet.com/ws/prematch

# Nalozi: korisnicko:lozinka, odvojeni zapetom. Koliko naloga — toliko botova.
# Primer: ACCOUNTS=test100:test100,test101:test101,test102:test102
ACCOUNTS=test100:test100

# === Parametri opterecenja (mogu i preko scenarios/default.json) ===
# Tempo: jedan tiket na ovoliko sekundi po botu.
TICKET_INTERVAL_SEC=60
# Posle ovoliko tiketa svaki bot pauzira PAUSE_MIN..PAUSE_MAX minuta.
TICKETS_BEFORE_PAUSE=100
PAUSE_MIN_MIN=1
PAUSE_MAX_MIN=30
# Ulog po tiketu (RSD), slucajno u rasponu.
STAKE_MIN=100
STAKE_MAX=500
# Parovi po tiketu.
LEGS_MIN=1
LEGS_MAX=7
# Verovatnoca da je tiket single (1 par), 0..1.
SINGLE_PROB=0.30
# Verovatnoca da par bude fudbal, 0..1.
FOOTBALL_PROB=0.50
# Najveca dozvoljena pojedinacna kvota.
MAX_ODDS=5
# Mecevi koji pocinju najdalje za ovoliko sati.
MAX_HOURS_AHEAD=24
